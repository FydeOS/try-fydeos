diff --git a/ui/sdl2.c b/ui/sdl2.c
index 5b6a0fd0..9c504c38 100644
--- a/ui/sdl2.c
+++ b/ui/sdl2.c
@@ -35,6 +35,7 @@
 #include "qemu/log.h"
 #include "qemu-main.h"
 #include "qapi/qapi-events-ui.h"
+#include "hw/display/edid.h"
 #include "sdl2-pinch-win32.h"
 
 #ifdef CONFIG_X11
@@ -87,6 +88,65 @@ static struct sdl2_console *get_scon_from_window(uint32_t window_id)
     return NULL;
 }
 
+#ifdef _WIN32
+/*
+ * EDID density follows the host scale as on the Mac (docs/macos/design.md
+ * D8): 110 DPI per unit of the window's DPI scale, 96 DPI being 100 %. The
+ * guest mode stays in window pixels; FydeOS picks its device scale factor
+ * from the density.
+ */
+static uint32_t sdl2_window_edid_dpi(SDL_Window *window)
+{
+    static UINT (WINAPI *get_dpi_for_window)(HWND);
+    SDL_SysWMinfo wm;
+    UINT dpi = 0;
+
+    if (!get_dpi_for_window) {
+        get_dpi_for_window = (void *)GetProcAddress(GetModuleHandleW(L"user32.dll"),
+                                                    "GetDpiForWindow");
+    }
+    SDL_VERSION(&wm.version);
+    if (get_dpi_for_window && window && SDL_GetWindowWMInfo(window, &wm)) {
+        dpi = get_dpi_for_window(wm.info.win.window);
+    }
+    return (MAX(dpi, 96) * 110 + 48) / 96;
+}
+
+static void sdl2_edid_debug(const char *what, struct sdl2_console *scon,
+                            const QemuUIInfo *info)
+{
+    if (g_strcmp0(getenv("TRY_FYDEOS_EDID_DEBUG"), "1")) {
+        return;
+    }
+    if (info) {
+        fprintf(stderr, "edid-density: %s: console %d, %u DPI, %ux%u px, %ux%u mm\n",
+                what, scon->idx, scon->edid_dpi, info->width, info->height,
+                info->width_mm, info->height_mm);
+    } else {
+        fprintf(stderr, "edid-density: %s: console %d, %u DPI\n",
+                what, scon->idx, scon->edid_dpi);
+    }
+}
+#endif
+
+static void sdl2_send_ui_info(struct sdl2_console *scon, int width, int height,
+                              const char *why)
+{
+    QemuUIInfo info;
+
+    memset(&info, 0, sizeof(info));
+    info.width = width;
+    info.height = height;
+#ifdef _WIN32
+    scon->edid_dpi = sdl2_window_edid_dpi(scon->real_window);
+    qemu_edid_dpi = scon->edid_dpi;
+    info.width_mm = qemu_edid_density_mm(scon->edid_dpi, width);
+    info.height_mm = qemu_edid_density_mm(scon->edid_dpi, height);
+    sdl2_edid_debug(why, scon, &info);
+#endif
+    dpy_set_ui_info(scon->dcl.con, &info, true);
+}
+
 #ifdef _WIN32
 /* The executable's icon resource (version.rc), at the sizes Windows asks for. */
 static void sdl2_set_resource_icon(SDL_Window *window)
@@ -178,6 +238,10 @@ void sdl2_window_create(struct sdl2_console *scon)
     sdl_update_caption(scon);
 #ifdef _WIN32
     sdl2_set_resource_icon(scon->real_window);
+    /* The default EDID (before any resize) carries the host density too. */
+    scon->edid_dpi = sdl2_window_edid_dpi(scon->real_window);
+    qemu_edid_dpi = scon->edid_dpi;
+    sdl2_edid_debug("window created", scon, NULL);
 #endif
 }
 
@@ -871,15 +935,21 @@ static void handle_windowevent(SDL_Event *ev)
 
     switch (ev->window.event) {
     case SDL_WINDOWEVENT_RESIZED:
-        {
-            QemuUIInfo info;
-            memset(&info, 0, sizeof(info));
-            info.width = ev->window.data1;
-            info.height = ev->window.data2;
-            dpy_set_ui_info(scon->dcl.con, &info, true);
-        }
+        sdl2_send_ui_info(scon, ev->window.data1, ev->window.data2, "resized");
         sdl2_redraw(scon);
         break;
+#ifdef _WIN32
+    case SDL_WINDOWEVENT_SIZE_CHANGED:
+    case SDL_WINDOWEVENT_DISPLAY_CHANGED:
+        /* A scale change that leaves the pixel size alone sends no RESIZED. */
+        if (sdl2_window_edid_dpi(scon->real_window) != scon->edid_dpi) {
+            int width, height;
+
+            SDL_GetWindowSize(scon->real_window, &width, &height);
+            sdl2_send_ui_info(scon, width, height, "scale changed");
+        }
+        break;
+#endif
     case SDL_WINDOWEVENT_EXPOSED:
         sdl2_redraw(scon);
         break;
