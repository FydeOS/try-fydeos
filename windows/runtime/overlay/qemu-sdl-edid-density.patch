diff --git a/ui/console.c b/ui/console.c
index 51256420..ac298b79 100644
--- a/ui/console.c
+++ b/ui/console.c
@@ -27,6 +27,7 @@
 #include "hw/core/qdev.h"
 
 uint32_t qemu_edid_refresh_rate_mhz;
