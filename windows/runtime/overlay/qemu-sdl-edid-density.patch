From: Try FydeOS contributors
Subject: [PATCH] sdl, edid: carry the Windows display scale in the EDID density

Applies after qemu-sdl-close-powerdown.patch.

Port of the macOS contract (docs/macos/design.md D8, Try Omarchy's
qemu-cocoa-dynamic-display.patch): the guest mode stays in window pixels,
and the EDID's physical size encodes the host scale at 110 DPI per scale
unit, rounded to whole centimetres as the base block stores them. FydeOS
picks its device scale factor from that density (project-vmware chromium
patch 0173): 100 % reads 110 DPI and scale 1, 150 % reads 165 DPI and
scale 1.5. SDL already makes the process per-monitor-v2 DPI aware and
reports sizes in pixels.

The scale is GetDpiForWindow / 96 of the SDL window. Each SDL window sets
qemu_edid_dpi when it is created, so the EDID the guest reads before any
resize (QEMU's default 100 DPI otherwise) carries it; every resize sends
the window size with the matching width_mm/height_mm; a scale change that
keeps the pixel size (moving to another monitor, changing the scale)
sends the current size again. The guest mode is not changed at start: the
window still follows the guest until the user resizes it.
TRY_FYDEOS_EDID_DEBUG=1 logs each value to stderr ("edid-density: ...").

diff --git a/hw/display/edid-generate.c b/hw/display/edid-generate.c
index b701df5f..905c48dd 100644
--- a/hw/display/edid-generate.c
+++ b/hw/display/edid-generate.c
@@ -12,6 +12,7 @@
  * Weak symbol so qemu-edid standalone tool links without console.c.
  */
 uint32_t __attribute__((weak)) qemu_edid_refresh_rate_mhz;
+uint32_t __attribute__((weak)) qemu_edid_dpi;
 
 static const struct edid_mode {
     uint32_t xres;
@@ -416,6 +417,10 @@ void qemu_edid_generate(uint8_t *edid, size_t size,
         width_mm = info->width_mm;
         height_mm = info->height_mm;
         dpi = qemu_edid_dpi_from_mm(width_mm, info->prefx);
+    } else if (qemu_edid_dpi) {
+        width_mm = qemu_edid_density_mm(qemu_edid_dpi, info->prefx);
+        height_mm = qemu_edid_density_mm(qemu_edid_dpi, info->prefy);
+        dpi = qemu_edid_dpi_from_mm(width_mm, info->prefx);
     } else {
         width_mm = qemu_edid_dpi_to_mm(dpi, info->prefx);
         height_mm = qemu_edid_dpi_to_mm(dpi, info->prefy);
diff --git a/include/hw/display/edid.h b/include/hw/display/edid.h
index 91c0a428..4bb16e1d 100644
--- a/include/hw/display/edid.h
+++ b/include/hw/display/edid.h
@@ -24,6 +24,12 @@ void qemu_edid_region_io(MemoryRegion *region, Object *owner,
 
 uint32_t qemu_edid_dpi_to_mm(uint32_t dpi, uint32_t res);
 
+/* res pixels at dpi in whole centimetres, the precision of the base block. */
+static inline uint32_t qemu_edid_density_mm(uint32_t dpi, uint32_t res)
+{
+    return 10 * MIN(255, MAX(1, (res * 254 + dpi * 50) / (dpi * 100)));
+}
+
 #define DEFINE_EDID_PROPERTIES(_state, _edid_info)                         \
     DEFINE_PROP_UINT32("xres", _state, _edid_info.prefx, 0),               \
     DEFINE_PROP_UINT32("yres", _state, _edid_info.prefy, 0),               \
diff --git a/include/ui/console.h b/include/ui/console.h
index 120f8207..cf7858df 100644
--- a/include/ui/console.h
+++ b/include/ui/console.h
@@ -50,6 +50,9 @@ OBJECT_DECLARE_SIMPLE_TYPE(QemuFixedTextConsole, QEMU_FIXED_TEXT_CONSOLE)
 /* Global EDID refresh rate from -display refresh-rate= option (millihertz) */
 extern uint32_t qemu_edid_refresh_rate_mhz;
 
+/* Density of the default EDID, 0 for QEMU's 100 DPI; set by the SDL display. */
+extern uint32_t qemu_edid_dpi;
+
 /* Color number is match to standard vga palette */
 enum qemu_color_names {
     QEMU_COLOR_BLACK   = 0,
diff --git a/include/ui/sdl2.h b/include/ui/sdl2.h
index a4ac4a3d..72d4abe2 100644
--- a/include/ui/sdl2.h
+++ b/include/ui/sdl2.h
@@ -55,6 +55,7 @@ struct sdl2_console {
     int guest_x, guest_y;
